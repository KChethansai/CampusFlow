# CampusFlow full API collection — manual REST Client flows (dev).
# Covers every router mounted in backend/APIs/index.js under /api/v1
# (23 resource routers + unversioned health below).
# Setup: run Login, copy accessToken into @token, then run any request.
@base = http://localhost:4000/api/v1
@token = <paste-access-token>

### Health (unversioned, backend/app.js)
GET http://localhost:4000/api/health

### Auth — login
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "admin@anurag.edu.in",
  "password": "<paste-dev-password>"
}

### Auth — refresh (rotating, backend/controllers/authcontroller.js)
POST {{base}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "<paste-refresh-token>"
}

### Auth — me
GET {{base}}/auth/me
Authorization: Bearer {{token}}

### Auth — register (super_admin/college_admin only, backend/APIs/authAPI.js)
POST {{base}}/auth/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "New Faculty",
  "email": "newfaculty@anurag.edu.in",
  "password": "<paste-dev-password>",
  "role": "faculty"
}

### Auth — change password
PATCH {{base}}/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "<paste-current-password>",
  "newPassword": "<paste-new-password>"
}

### Auth — forgot / reset password (rate-limited 10/15min)
POST {{base}}/auth/forgot-password
Content-Type: application/json

{
  "email": "student1@anurag.edu.in"
}

### Auth — reset password
POST {{base}}/auth/reset-password
Content-Type: application/json

{
  "token": "<reset-token>",
  "newPassword": "<paste-new-password>"
}

### Auth — logout (refresh-tolerant)
POST {{base}}/auth/logout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "refreshToken": "<paste-refresh-token>"
}

### Users — list (tenant-scoped, paginated)
GET {{base}}/users?page=1&limit=20
Authorization: Bearer {{token}}

### Users — get by id (scopedOne: 404 across tenants)
GET {{base}}/users/<user-id>
Authorization: Bearer {{token}}

### Users — update allowlisted fields
PATCH {{base}}/users/<user-id>
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Name"
}

### Users — deactivate (isActive=false)
PATCH {{base}}/users/<user-id>/deactivate
Authorization: Bearer {{token}}

### Users — onboarding
PATCH {{base}}/users/me/onboarding
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Institutions — list / detail
GET {{base}}/institutions
Authorization: Bearer {{token}}

### Institutions — detail
GET {{base}}/institutions/<institution-id>
Authorization: Bearer {{token}}

### Institutions — create (super_admin ONLY, backend/APIs/institutionAPI.js)
POST {{base}}/institutions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Demo Institute",
  "domain": "demo.edu.in"
}

### Institutions — update (super_admin ONLY)
PATCH {{base}}/institutions/<institution-id>
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Demo Institute Renamed"
}

