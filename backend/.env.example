# ── CampusFlow backend environment ─────────────────────────────────────
# Copy to backend/.env and fill in real values. Never commit .env.
# NODE_ENV=production is required on Render; development is the default.

NODE_ENV=development
PORT=5000

# MongoDB connection (Atlas recommended for production)
# DB_URL is preferred; MONGO_URI is accepted as a legacy alias.
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusflow

# JWT secrets — use long random strings (openssl rand -hex 32)
SECRET_KEY=change-me-access-secret
SECRET_KEY_REFRESH=change-me-refresh-secret
# Legacy alias names are also accepted: JWT_ACCESS_SECRET / JWT_REFRESH_SECRET

# Token lifetimes
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS — comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Cookie policy — keep default; 'none' is implied in production
# COOKIE_SAME_SITE=lax

# Uploads
UPLOAD_DIR=uploads/
MAX_FILE_MB=10

# SMTP / email (used by email.service.js; password-reset notifications fall
# back to in-app notifications when SMTP is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@campusflow.app

# AI reports (optional — reports fall back to a placeholder summary without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEMOTRON_MODEL=
