# ── CampusFlow frontend environment ────────────────────────────────────
# Copy to frontend/.env for local development, and set the same variable
# in Vercel for preview/production deployments.

# Base URL of the backend API (no trailing slash).
# Local dev backend: http://localhost:5000/api/v1
VITE_API_URL=https://your-backend.onrender.com/api/v1
